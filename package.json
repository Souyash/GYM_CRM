{
  "name": "ironvault-gym-crm",
  "version": "1.0.0",
  "description": "Commercial Gym CRM & Member Management System with Turnstile Entry/Exit Scanning",
  "private": true,
  "scripts": {
    "build": "cd client && npm run build",
    "fix:git": "bash fix-git.sh",
    "client:dev": "npm run dev --prefix client",
    "server:dev": "npm run dev --prefix server",
    "server:build": "npm run build --prefix server",
    "mobile:sync": "cd client && npm run cap:sync",
    "mobile:ios": "cd client && npm run cap:open:ios",
    "mobile:android": "cd client && npm run cap:open:android"
  },
  "dependencies": {
    "nodemailer": "^6.9.16"
  },
  "keywords": [
    "gym-crm",
    "turnstile",
    "fitness",
    "react",
    "vite",
    "express",
    "prisma"
  ],
  "author": "IronVault Team",
  "license": "MIT"
}

