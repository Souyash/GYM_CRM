{
  "name": "gym-crm-server",
  "version": "1.0.0",
  "type": "module",
  "description": "Gym CRM backend with hardware-free smart access and anti-fraud protocols",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "node setup-env.js",
    "build": "node setup-env.js && prisma generate && prisma db push && tsc",
    "prestart": "node setup-env.js",
    "start": "node setup-env.js && node dist/server.js",
    "preseed": "node setup-env.js",
    "seed": "node setup-env.js && tsx prisma/seed.ts",
    "prisma:generate": "node setup-env.js && prisma generate",
    "prisma:push": "node setup-env.js && prisma db push",
    "prisma:seed": "node setup-env.js && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.3",
    "prisma": "^6.4.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.5",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^10.0.0"
  }
}
